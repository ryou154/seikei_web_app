{
  "name": "seikei-web-app",
  "version": "1.0.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "clinics:check": "node --env-file-if-exists=.env scripts/import-clinics.js",
    "clinics:import": "node --env-file-if-exists=.env scripts/import-clinics.js --write",
    "clinics:places:plan": "node --env-file-if-exists=.env scripts/sync-google-places.js",
    "clinics:places:check": "node --env-file-if-exists=.env scripts/sync-google-places.js --execute",
    "clinics:places:sync": "node --env-file-if-exists=.env scripts/sync-google-places.js --write",
    "clinics:places:auto-publish": "node --env-file-if-exists=.env scripts/sync-google-places.js --all --auto-publish --limit-per-prefecture 10",
    "clinics:official:plan": "node --env-file-if-exists=.env scripts/sync-clinic-official.js --all --limit 10",
    "clinics:official:sync": "node --env-file-if-exists=.env scripts/sync-clinic-official.js --all --limit 10 --execute",
    "clinics:official:auto-apply": "node --env-file-if-exists=.env scripts/sync-clinic-official.js --all --limit 50 --execute --auto-apply"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "firebase-admin": "14.5.0",
    "three": "^0.186.1"
  }
}
